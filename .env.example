# ──────────────────────────────────────────────────────────────
# Vergabepilot.AI – environment variables
# Copy this file to `.env` and fill in the values before running
# `docker compose up`.
# ──────────────────────────────────────────────────────────────

# --- LLM providers -------------------------------------------------------
# OpenRouter is the default (multi-model, as per project brief).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct providers (used as fallback if OpenRouter is down)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default model identifiers (OpenRouter format: provider/model)
LLM_MODEL_PRIMARY=google/gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=openai/gpt-4o-mini
LLM_MODEL_VISION=google/gemini-2.5-flash-lite

# --- Database ------------------------------------------------------------
POSTGRES_USER=vergabepilot
POSTGRES_PASSWORD=vergabepilot
POSTGRES_DB=vergabepilot

# --- Object storage (MinIO / S3) -----------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=vergabepilot-documents
S3_REGION=eu-central-1

# --- Phase 1: sandboxing -------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=512
MAX_FEEDBACK_ITERATIONS=5

# --- Phase 2: CUA --------------------------------------------------------
CUA_MAX_STEPS=30
CUA_SCREENSHOT_DIR=/tmp/vergabepilot-screenshots

# --- Phase 3: integration ------------------------------------------------
SCRAPER_REGISTRY_PATH=/app/data/scrapers
ENABLE_FALLBACK_CUA=true
VERSIONING_CHECK_INTERVAL_HOURS=24

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000
