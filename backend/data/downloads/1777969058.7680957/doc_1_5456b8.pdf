<script type="text/javascript">
/*<![CDATA[*/
Wicket.Event.add(window, "load", function(event) { 
$('#ide').disableOnClick(false);;
$('#id12').disableOnClick(false);;
$('#id14 a').append('<span class="sr-only">Zurzeit aktiv<\/span>');;
$('#id15 a').append('<span class="sr-only">Zurzeit aktiv<\/span>');;
$('#loginModal').on('shown.bs.modal', function () {  $('#id2').focus().select();});;
$('#id1a .has-error input:first').focus();;
$('#id24 a').append('<span class="sr-only">Zurzeit aktiv<\/span>');;
$('#deadlineFrom').datepicker();;
$('#deadlineTo').datepicker();;
$('#tenderFloatingPeriodFrom').datepicker();;
$('#tenderFloatingPeriodTo').datepicker();;
$('#publishDateFrom').datepicker();;
$('#publishDateTo').datepicker();;
 $('#categories').multipleSelect({
    placeholder: 'Bitte wählen',
    selectAllText: 'Alle',
    allSelected: 'Alle ausgewählt',
    countSelected: '# von % ausgewählt'
});;
$('#searchLinkModalInput').on('click', function(){$(this).select();});
$('#datatable').createToggleColumnsPopup({"toggleLabel":"Spalten ein-/ausblenden","tableName":"search-result-procedures-table","toggleOffLabel":"Spalte ausblenden","toggleOnLabel":"Spalte einblenden"});
$('th.result_col_deadline').addTooltip('Hinweis', 'Alle relevanten Fristen finden Sie in den Ausschreibungsdetails.');
;});
/*]]>*/
</script>

