<option value="FOURTEEN_DAYS">Letzte 14 Tage</option>
<option value="TWENTY_ONE_DAYS">Letzte 21 Tage</option>
<option value="TWENTY_EIGHT_DAYS">Letzte 28 Tage</option>
</select>

