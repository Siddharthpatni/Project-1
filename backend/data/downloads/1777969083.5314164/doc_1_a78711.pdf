<script type="text/javascript">
/*<![CDATA[*/

	jQuery( document ).ready(function() {
		function toggleFunction(component, event){
			if($(component).attr("expandable") == "expanded"){
				$(event).preventDefault();
				$(component).next("ul").hide();
				$(component).attr("expandable","collapsed");
			}else{
				//$(component).next("ul").show();
				$(component).attr("expandable","expanded");
			}
		}
		function init(component){
			var activeSubElements = $(component).siblings().find("a[id='subActive']");
			console.log(activeSubElements);
			if(activeSubElements.length>0){
				$(component).next("ul").show();
			}else {
				$(component).next("ul").hide();
				if ($(component).attr("expandable") == "expanded") {

					$(component).next("ul").show();
				} else if ($(component).attr("expandable") == "collapsed") {
					$(component).next("ul").hide();
				}
			}
		}
		$("a[expandable]").each(function(index){
			init($(this));
			$(this).on("click", function(event){

				toggleFunction($(this), event);
			});
		});
	});

/*]]>*/
</script>
