	<script type="text/javascript">
/*<![CDATA[*/

		function applyStylesAndEnhancements(attrs, jqXHR, textStatus) {
			
			// init template enhancements
			var containerExpression = jqXHR;
			$(containerExpression).find("textarea[data-template]").each(
				function(textarea)
				{
					Template.initTextarea($(this));
				}
			);
			
			// init form enhancements
			setTimeout(function(){CXFormular.init();},1000);

			// init tooltip function for hints
			initToolTip();

			// init sorting table headers
			if (typeof initTableSorting === "function")
			{
				initTableSorting();
			}
		}
		jQuery(document).ready(function() {
			try{
				Wicket.Event.subscribe('/dom/node/added', applyStylesAndEnhancements);
			}catch(err){
				
			}
		});
	
/*]]>*/
</script>
	<script type="text/javascript">
/*<![CDATA[*/

