        transition: all 0.25s ease-in-out;
  color: white;
    padding:3px;
  text-decoration: underline;
}

#mein-link:hover {
  background-color: #446600;
    transition: all 0.25s ease-in-out;
}
@media screen and (max-width: 2030px) {
