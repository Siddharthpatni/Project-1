    display: none;
  }
}
</style><div class="sticky-banner"><h2 class="headline-banner">Alle Ausschreibungen im Komfort-Tarif</h2><p class="price">schon ab 42,00 € mtl.</p><a href="/recherchetarife" class="btn btn-primary" style="width: 100%;">Hier informieren</a><p class="list-title">Ihre Vorteile:</p><ul id="my-list"><li><span class="fa-li"><i class="fal fa-search"></i></span> Zugriff auf alle Ausschreibungen</li><li><span class="fa-li"><i class="fal fa-plus"></i></span> Laufend neue Auftragschancen</li><li><span class="fa-li"><i class="fal fa-envelope"></i></span> E-Mail bei neuen Ausschreibungen</li><li><span class="fa-li"><i class="fal fa-file-pdf"></i></span> PDF-Export der Ausschreibungen</li><li><span class="fa-li"><i class="fal fa-cloud-upload"></i></span> Teilnahme an eVergaben</li><li><span class="fa-li"><i class="fal fa-user-headset"></i></span> Persönlicher Kundensupport</li></ul><p style="color:white; text-align:center">
  
Fragen? Wir beraten Sie gerne<br><a href="tel:+49211882738288"  id="mein-link"><i class="fal fa-phone fa-flip-horizontal"></i>&nbsp;0211/88 27 38 - 288</a></p></div><script>
  // Get the sticky banner element
  var stickyBanner = document.querySelector('.sticky-banner');

  // Get the initial offset position of the banner
  var stickyBannerOffset = stickyBanner.offsetTop;

  // Create a function that will be called when the user scrolls
  function stickyBannerOnScroll() {
    // Check if the user has scrolled past the initial offset position of the banner
    if (window.pageYOffset > stickyBannerOffset) {
      // Add a class to the banner that sets its position to fixed and makes it stick to the top
      stickyBanner.classList.add('sticky');
    } else {
      // Remove the class if the user scrolls back up to the initial position
      stickyBanner.classList.remove('sticky');
    }
  }

  // Add an event listener to the window object that calls the stickyBannerOnScroll function when the user scrolls
  window.addEventListener('scroll', stickyBannerOnScroll);
</script></div></div></div></div></div></div></div></div></div><!--TYPO3SEARCH_end--></main><footer><div class="footer-wrapper"><div class="pt-5 bg-blue text-white"><div class="container"></div></div></div><section id="c65867" style="" class="section text-left pt-1 pb-5 text-black  bg-primary  "><div class="section__content"><div class="container"><div class="row"><div class="col"><div class="row contact  "><div class="col-12 col-sm-12 col-md-3    "><div id="c66091" class="frame frame-default frame-type-textmedia frame-layout-0 frame-background-none frame-no-backgroundimage frame-space-before-none frame-space-after-global-space-after-small"><div class="frame-container"><div class="frame-inner"><div class="ce-textpic ce-center ce-above"><div class="text-center justify-content-center col-sm-12 "><figure class="image"><img srcset="/fileadmin/Bilder/Logos/deutsches-ausschreibungsblatt_logo_weiss.svg 766w,
